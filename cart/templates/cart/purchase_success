{% extends "base.html" %}
{% block content %}
<div class="container mt-4">
  <div class="alert alert-success">
    <strong>Success!</strong> Order #{{ template_data.order.id }} completed.
  </div>

  <p>Quick note about your checkout?</p>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#surveyModal">
    Leave a short statement
  </button>

  <!-- Survey Modal -->
  <div class="modal fade" id="surveyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="post" action="{% url 'cart_survey' template_data.order.id %}">
          {% csrf_token %}
          <div class="modal-header">
            <h5 class="modal-title">Checkout Survey</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Name (optional)</label>
              {{ template_data.form.name }}
            </div>
            <div class="mb-3">
              <label class="form-label">Short statement</label>
              {{ template_data.form.message }}
            </div>
            <div class="form-check">
              {{ template_data.form.anonymous }}
              <label class="form-check-label">Post anonymously</label>
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Skip</button>
            <button class="btn btn-primary" type="submit">Submit</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="mt-3">
    <a class="btn btn-outline-secondary" href="{% url 'cart_survey_list' %}">View all statements</a>
    <a class="btn btn-link" href="{% url 'movies_index' %}">Back to Movies</a>
  </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  var el = document.getElementById('surveyModal');
  if (el && window.bootstrap) new bootstrap.Modal(el).show();
});
</script>
{% endblock %}
